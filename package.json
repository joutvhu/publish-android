{
  "name": "publish-android",
  "version": "2.0.0",
  "description": "Github Action to upload a Android release (.apk or .aab) to the Google Play Store",
  "scripts": {
    "build": "npm run clean && tsc --project tsconfig.json",
    "release": "ncc build src/publish-android.ts -o action && git add -f action/",
    "clean": "rimraf -- action",
    "lint": "eslint **/*.ts"
  },
  "keywords": [
    "actions",
    "github",
    "publish",
    "android"
  ],
  "author": {
    "name": "Giao Ho",
    "email": "joutvhu@gmail.com",
    "url": "https://github.com/joutvhu"
  },
  "license": "MIT",
  "homepage": "https://github.com/joutvhu/publish-android#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/joutvhu/publish-android.git"
  },
  "bugs": {
    "url": "https://github.com/joutvhu/publish-android/issues"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=7.0.2"
  },
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@googleapis/androidpublisher": "^35.3.0",
    "fast-glob": "^3.3.3",
    "jszip": "^3.10.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@tsconfig/recommended": "^1.0.13",
    "@types/node": "^24.12.2",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-promise": "^7.2.1",
    "jest": "^30.3.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  }
}
